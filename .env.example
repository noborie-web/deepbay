# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# eBay OAuth and inventory actions (required for eBay connection/sync/actions)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI_NAME=
# Base64-encoded 32-byte key. Keep this value stable after storing OAuth tokens.
EBAY_TOKEN_ENCRYPTION_KEY=

# Vercel Cron authentication (required for scheduled inventory execution)
CRON_SECRET=

# Title translation (optional; original titles are used when omitted)
OPENAI_API_KEY=

# eBayの1日の呼び出し上限(未設定なら10000)。実際の上限は developer.ebay.com の
# Application Growth Check で確認する(GetApiAccessRules は廃止・HTTP 410)。
# EBAY_DAILY_CALL_LIMIT=10000
# 上のうち、価格改定・取り下げ・手動操作のために残す分(未設定なら1200)
# EBAY_RESERVED_CALLS=1200
